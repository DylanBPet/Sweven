"},{"#f":5}]}],{"#f":1}],"WhosHer":[["^Emma. We can bring her back, thats what this was all about, the fire, the animals, I didnt mean for anyone to get hurt. ","#","^speaker: Nick ","/#","#","^portrait:nick ","/#","#","^layout:right","/#","\n","^Its just what had to be done ","#","^speaker: Nick ","/#","#","^portrait:nick ","/#","#","^layout:right","/#","\n","ev","str","^Its not natural!","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^We can!?","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["^ This is not right, its not natural ","#","^speaker: Marcus ","/#","#","^portrait:marcus ","/#","#","^layout:left","/#","\n",{"->":"ItsNotNatural"},{"#f":5}],"c-1":["^ We can bring her back? ","#","^speaker: Marcus ","/#","#","^portrait:marcus ","/#","#","^layout:left","/#","\n",{"->":"WeCan"},{"#f":5}]}],{"#f":1}],"ThisIsntYou":[["^My home was taken from me. She was taken from you too. We can bring her back ","#","^speaker: Nick ","/#","#","^portrait:nick ","/#","#","^layout:right","/#","\n","ev","str","^Explain?","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Who?","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["^ What are you talking about? ","#","^speaker: Marcus ","/#","#","^portrait:marcus ","/#","#","^layout:left","/#","\n",{"->":"WhosHer"},{"#f":5}],"c-1":["^ Who? ","#","^speaker: Marcus ","/#","#","^portrait:marcus ","/#","#","^layout:left","/#","\n",{"->":"WhosHer"},{"#f":5}]}],{"#f":1}],"ItsNotNatural":[["^Nothing about what happened to her was natural. She was sick, not ready to go ","#","^speaker: Nick ","/#","#","^portrait:nick ","/#","#","^layout:right","/#","\n","ev","str","^You were not ready","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^The Dreams","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["^ No Nick, you were not ready to let her go. ","#","^speaker: Marcus ","/#","#","^portrait:marcus ","/#","#","^layout:left","/#","\n",{"->":"YouWereNotReady"},{"#f":5}],"c-1":["^ The dreams. Shes been trying to warn me ","#","^speaker: Marcus ","/#","#","^portrai